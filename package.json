{
  "name": "electron-tray-alarm",
  "version": "1.0.0",
  "description": "Electron alarm app with system tray",
  "main": "dist/main.js",
  "scripts": {
    "start": "npm run build && node scripts/run-electron.cjs",
    "dev": "npm run build && node scripts/run-electron.cjs",
    "devm": "npm run build && node scripts/run-electron.cjs --multi-instance",
    "build": "tsc && node scripts/copy-assets.cjs",
    "typecheck": "tsc --noEmit",
    "build:electron": "electron-builder --publish never",
    "test:unit": "npm run build && node --test tests/unit/*.test.cjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "canvas": "^3.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.19.27",
    "electron": "^28.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.electron.tray-alarm",
    "productName": "Tray Alarm",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "portable-mode",
        "to": "portable-mode"
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities"
    }
  }
}
